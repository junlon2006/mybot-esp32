menu "mybot"

    choice MYBOT_LANGUAGE
        prompt "Product language"
        default MYBOT_LANGUAGE_ZH_CN

        config MYBOT_LANGUAGE_ZH_CN
            bool "Chinese (zh-CN)"

        config MYBOT_LANGUAGE_EN_US
            bool "English (en-US)"
    endchoice

    config MYBOT_LANGUAGE_TAG
        string
        default "en-US" if MYBOT_LANGUAGE_EN_US
        default "zh-CN"

    config MYBOT_SERVER_BASE
        string "Device API server base URL"
        default "https://mybot.sh2.agoralab.co/api"

    choice MYBOT_AUDIO_PTIME
        prompt "Audio packet duration"
        default MYBOT_AUDIO_PTIME_60

        help
            The bundled ESP32-S3 Agora RTSA package emits 60 ms jitter-buffer frames.
            Selecting 20 ms or 40 ms requires a matching RTSA package and fails the
            component configuration check until that package is supplied.

        config MYBOT_AUDIO_PTIME_20
            bool "20 ms"

        config MYBOT_AUDIO_PTIME_40
            bool "40 ms"

        config MYBOT_AUDIO_PTIME_60
            bool "60 ms"
    endchoice

    config MYBOT_AUDIO_PTIME_MS
        int
        default 20 if MYBOT_AUDIO_PTIME_20
        default 40 if MYBOT_AUDIO_PTIME_40
        default 60 if MYBOT_AUDIO_PTIME_60

    config MYBOT_CLOUD_AEC
        bool "Enable cloud AEC"
        default y

    config MYBOT_AI_QOS
        bool "Enable Agora AI QoS"
        default y

    config MYBOT_FAST_SEND_MULTIPLIER
        int "Agora fast-send multiplier"
        range 1 5
        default 3

    config MYBOT_DEBUG_RESOURCE_MONITOR
        bool "Enable debug CPU and memory monitor"
        default n
        depends on !FREERTOS_SMP
        select FREERTOS_GENERATE_RUN_TIME_STATS
        help
            Log per-core busy time estimated from idle runtime deltas and heap
            statistics using a low-priority task. Adds scheduler accounting and
            serial logging overhead; intended for diagnostics only.

    config MYBOT_ENABLE_VIDEO
        bool "Enable CoreS3 camera JPEG uplink (1 fps)"
        default n
        select CAMERA_GC0308
        select CAMERA_GC0308_DVP_YUV422_YUYV_320X240_20FPS
        help
            Requires the m5stack-core-s3 board and a video-capable RTSA package.
            Uploads 320x240 JPEG images at most once per second while RTC is connected.
            The platform requests DVP capture at most five times per second.
            Capture and software encoding consume additional RAM and CPU.

    config MYBOT_AUDIO_PLAYBACK_TEST
        bool "Run CoreS3 offline audio playback A/B test at boot"
        default n
        depends on !MYBOT_ENABLE_VIDEO
        help
            CoreS3 only. Replaces normal startup with three 60-second tests of
            identical local PCM: timer-fed with capture, continuous with capture,
            and continuous without capture. Uses the saved speaker volume.
            Wi-Fi and mybot are not started. Disable and rebuild to resume normal use.

    config MYBOT_LVGL_UI_LIGHT_THEME
        bool "Use the LVGL light theme"
        depends on MYBOT_LVGL_UI
        default n
        help
            Select the light palette at build time. The default is the dark palette.

    config MYBOT_LVGL_UI_ANIMATIONS
        bool "Animate LVGL conversation status"
        depends on MYBOT_LVGL_UI
        default y
        help
            Animate small state indicators at up to 5 frames per second while
            listening, thinking or speaking. These are state animations, not an
            audio waveform. Overflowing provisioning text can still scroll
            when this option is disabled.

    config MYBOT_DEBUG_RESOURCE_MONITOR_INTERVAL_MS
        int "Resource monitor interval (ms)"
        depends on MYBOT_DEBUG_RESOURCE_MONITOR
        range 1000 60000
        default 5000

endmenu
